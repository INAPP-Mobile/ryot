# Ryot Configuration
# ===================

# REQUIRED: PostgreSQL database URL (Railway auto-fills this via companion DB)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# REQUIRED: Set to a long random string for admin access
SERVER_ADMIN_ACCESS_TOKEN=change_me_to_a_long_random_string

# REQUIRED: The public URL of your Ryot instance (e.g., https://ryot-production.up.railway.app)
FRONTEND_URL=http://localhost:8000

# Optional: Timezone (IANA format, e.g., Europe/Amsterdam, America/New_York)
# TZ=GMT

# Optional: Disable telemetry
# DISABLE_TELEMETRY=true

# Optional: TMDB access token for movies and shows tracking
# MOVIES_AND_SHOWS_TMDB_ACCESS_TOKEN=

# Optional: Twitch client ID and secret for video games tracking
# VIDEO_GAMES_TWITCH_CLIENT_ID=
# VIDEO_GAMES_TWITCH_CLIENT_SECRET=
